# Copy this file to .env before starting local services.
# Do not use these values in any deployed environment.
POSTGRES_DB=meal_logger
POSTGRES_USER=meal_logger
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432

# Used by the backend once database connectivity is implemented.
DATABASE_URL=postgres://meal_logger:change-me-for-local-development@localhost:5432/meal_logger
